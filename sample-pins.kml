<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Sample places (fake data, for testing Upload KML)</name>
    <Folder>
      <name>Substations</name>
      <Placemark>
        <name>Sample Substation A</name>
        <description>Example description. Gate is on the north side.</description>
        <ExtendedData><Data name="Capacity"><value>25 MVA</value></Data></ExtendedData>
        <Point><coordinates>124.6460,8.4772,0</coordinates></Point>
      </Placemark>
    </Folder>
    <Folder>
      <name>Offices</name>
      <Placemark>
        <name>Sample District Office</name>
        <description><![CDATA[<b>Open</b> Mon-Fri<br>8:00 AM - 5:00 PM]]></description>
        <Point><coordinates>124.6550,8.4830,0</coordinates></Point>
      </Placemark>
    </Folder>
  </Document>
</kml>
